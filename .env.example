# Ninox environment variables — copy to .env

# GFW API token (free: https://globalfishingwatch.org/our-apis/)
GFW_API_TOKEN=

# MarineTraffic API key (commercial, optional)
MARINETRAFFIC_API_KEY=

# Database (TimescaleDB / PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/ninox

# RF hardware (set after RTL-SDR deployment)
SDR_DEVICE_INDEX=0
SDR_SAMPLE_RATE=2000000
SDR_CENTER_FREQ=162000000
